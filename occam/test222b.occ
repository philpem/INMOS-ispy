
-- --------------------------------------------------
--
--    test222b.occ  --  T2 test code
--
-- --------------------------------------------------



#INCLUDE "checklib.occ"
PROC test222b(VAL INT boot)
  --{{{  DpathT222C (BOOL Pass) 624
  PROC DpathT222C (BOOL Pass)
  
    --{{{  Comment
    -- This tests the registers on the datapath using different values
    -- for each register, in order to observe that stack is correctly
    -- pushing and popping, and set each bit of each register to 1 and 0
    -- to check stuck-at faults.
    --}}}
  
    --{{{  Declaration
    INT Result :
      -- This is used to compare a computed result against an expected value.
    --}}}
    --{{{  PROC VerifyResult (BOOL pass, INT result, VAL INT Expected)
    PROC VerifyResult (BOOL pass, INT result, VAL INT Expected)
    
      -- Every Dpath test requires a computed result to be tested against a known
      -- or expected value. This proc performs the testing.
      -- The proc sets pass if result differs from Expected.
    
      IF
        result = Expected
          SKIP
        TRUE
          pass := FALSE
    :
    --}}}
    SEQ
      --{{{  Initialise
      Pass := TRUE           -- Assume Device Okay Until Fault Found.
      Result := #EEEE    -- Not one of the Expected Values.
      --}}}
      --{{{  Test the Stack Registers
      GUY
        LDC   #1111
        LDC   #2222
        LDC   #3333
        STL   Result
      VerifyResult (Pass, Result, #3333)
      
      GUY
        LDC   #1111
        LDC   #2222
        LDC   #3333
        STL   Result
        STL   Result
      VerifyResult (Pass, Result, #2222)
      
      GUY
        LDC   #1111
        LDC   #2222
        LDC   #3333
        STL   Result
        STL   Result
        STL   Result
      VerifyResult (Pass, Result, #1111)
      
      GUY
        LDC   #EEEE
        LDC   #DDDD
        LDC   #CCCC
        STL   Result
      VerifyResult (Pass, Result, #CCCC)
      
      GUY
        LDC   #EEEE
        LDC   #DDDD
        LDC   #CCCC
        STL   Result
        STL   Result
      VerifyResult (Pass, Result, #DDDD)
      
      GUY
        LDC   #EEEE
        LDC   #DDDD
        LDC   #CCCC
        STL   Result
        STL   Result
        STL   Result
      VerifyResult (Pass, Result, #EEEE)
      --}}}
      --{{{  Test Dreg, Ereg and STATUSreg
      --{{{  Comment
      -- Avoid use of both ErrorBit and HaltOnErrorBit
      -- Note that the two STATUSreg conditional bits are not loadable.
      --}}}
      GUY
        STEP REV              -- clear STATUSreg cond bits
        LDC   0               -- clear Oreg and push stack
        LDC   #4BB4
        LDC   #5555
        LDC   #6666
        TESTSTD
        TESTSTE
        TESTSTS
      
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, #0BB4)
      
      GUY
        TESTLDE
        STL   Result
      VerifyResult (Pass, Result, #5555)
      
      GUY
        TESTLDD
        STL   Result
      VerifyResult (Pass, Result, #6666)
      
      GUY
        LDC   #B44B
        LDC   #AAAA
        LDC   #9999
        TESTSTD
        TESTSTE
        TESTSTS
      
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, #944B)
      
      GUY
        TESTLDE
        STL   Result
      VerifyResult (Pass, Result, #AAAA)
      
      GUY
        TESTLDD
        STL   Result
      VerifyResult (Pass, Result, #9999)
      --}}}
      --{{{  Test Oreg
      GUY     -- Oreg  (loaded by prefixing)
        LDC   #1234
        STL   Result
      VerifyResult (Pass, Result, #1234)
      
      GUY
        LDC   #FEDC
        STL   Result
      VerifyResult (Pass, Result, #FEDC)
      --}}}
      --{{{  Test LFptr and LBptr
      [2]INT Temp :
      SEQ
        GUY
          LDC   #1112
          LDC   #2223
          STLB
          STLF
          LDLP Temp [0]
          SAVEL
        VerifyResult (Pass, Temp [0], #1112)
        VerifyResult (Pass, Temp [1], #2223)
      
        GUY
          LDC   #EEED
          LDC   #DDDC
          STLB
          STLF
          LDLP Temp [0]
          SAVEL
        VerifyResult (Pass, Temp [0], #EEED)
        VerifyResult (Pass, Temp [1], #DDDC)
      
        GUY
          MINT
          STLF                -- restore low queue to empty (NotProcess)
      --}}}
      --{{{  Test HFptr and HBptr
      [2]INT Temp :
      SEQ
        GUY
          LDC   #3334
          LDC   #4445
          STHB
          STHF
          LDLP  Temp [0]
          SAVEH
        VerifyResult (Pass, Temp [0], #3334)
        VerifyResult (Pass, Temp [1], #4445)
      
        GUY
          LDC   #CCCB
          LDC   #BBBA
          STHB
          STHF
          LDLP  Temp [0]
          SAVEH
        VerifyResult (Pass, Temp [0], #CCCB)
        VerifyResult (Pass, Temp [1], #BBBA)
      
        GUY
          MINT
          STHF                -- restore high queue to empty (NotProcess)
      --}}}
      --{{{  Test Channel Registers
      INT Counter :
      SEQ
        --{{{  Write Unique Values to all Channel Registers
        Counter := 0
        SEQ i = 0 FOR 8
          SEQ j = 0 FOR 3
            SEQ
              GUY
                LDL Counter
                ADC   #C0C0
                LDL   i
                BCNT
                TESTHARDCHAN
              Counter := Counter + 1
        --}}}
        --{{{  Write Inverse Unique Values to all Channel Registers
        Counter := 0
        SEQ i = 0 FOR 8
          SEQ j = 0 FOR 3
            SEQ
              GUY
                LDL Counter
                ADC   #C0C0
                NOT
                LDL   i
                BCNT
                TESTHARDCHAN
                STL   Result
              VerifyResult (Pass, Result, Counter + #C0C0)
              Counter := Counter + 1
        --}}}
        --{{{  Read Last Values from all Channel Registers
        Counter := 0
        SEQ i = 0 FOR 8
          SEQ j = 0 FOR 3
            SEQ
              GUY
                LDL   i
                BCNT
                TESTHARDCHAN
                STL  Result
              VerifyResult (Pass, Result, #3F3F - Counter)
              Counter := Counter + 1
        --}}}
      --}}}
      --{{{  Test Wptr                     -- T2      Sc Dpath
      
      --   The original test requires that the timer should not have been started
      -- and that no other processes are waiting. Since this state cannot be achieved
      -- in a program useful for functional testing the original test has been
      -- changed.
      --   The new Wptr test checks all the Wptr bits for "stuck at" faults -
      -- except for the last bit. The last bit indicates the priority of the process.
      
      PRI PAR
        INT OldWptr, NewWptr :
        SEQ
          --{{{  Test Wptr
          GUY
            LDLP  0                       -- Form address of OldWptr
            TESTSTD                       -- Dreg := OldWptr
            TESTLDD                       -- Areg := OldWptr
            STL  OldWptr
            TESTLDD                       -- Areg := OldWptr
            NOT                           -- Complement the Bit Pattern
            LDC  #FFFE                    -- Ensure byte selector is zero.
            AND
            GAJW                          -- Write the pattern into Wptr
                                          -- Areg := OldWptr
          
            TESTLDD                       -- Areg := OldWptr
            GAJW                          -- Restore OldWptr and
                                          -- Areg = Complement of OldWptr
            STL NewWptr
          
          OldWptr := OldWptr \/ 1         -- Allows the use of ~ in the next line.
          VerifyResult (Pass, NewWptr, ~ OldWptr)
          
          --}}}
        SKIP
      --}}}
  :
  --}}}
  --{{{  AluT222C   (BOOL Pass) 550
  PROC AluT222C (BOOL Pass)
  
    -- Check generate and propagate on Xbus and Ybus from each bit position
    -- subtraction and all logical functions. This causes all the 8 columns
    -- for the AluOpsField to be set, except YbusByteMask, which should
    -- be tested with a complete block move test.
  
    --{{{  Comment
    
    -- Different sections of the alu are tested by generating bit patterns using
    -- theses parts and comparing these patterns against expected bit patterns.
    -- In order to reduce the amount of memory required to do the comparing some
    -- of the expected bit patterns are generated at run time, Result Gen,
    -- Result Prop X and Result Prop Y.
    
    -- Note : If the way in which expected bit patterns are generated at run time
    -- is equivalent to the way in which the alu has generated the bit pattern
    -- the test is obviously invalid.
    -- The possibility of an error occurring in both methods that produces
    -- equivalent bit patterns is assumed to be negligible.
    --}}}
  
    --{{{  Definitions and Declarations
    VAL INT BitsInWord IS 16 :
    
    INT Result :  -- Used to compare a computed result against an expected value.
    
    INT Arg1, Arg2 : -- Used as arguments in logical and arithmetic operations.
    --}}}
    --{{{  PROC VerifyResult (BOOL pass, INT result, VAL INT Expected)
    PROC VerifyResult (BOOL pass, INT result, VAL INT Expected)
    
      -- Every Alu test requires a computed result to be tested against a known
      -- or expected value. This proc performs the testing.
      -- The proc sets pass if result differs from Expected and resets result.
      -- result is reset for the following reason. Some adjacent Alu tests
      -- require the same expected values. If for any reason result failed to be
      -- re-assigned the next test might indicate a pass irrespective of whether
      -- the alu was functioning correctly.
    
      SEQ
        IF
          result = Expected
            SKIP
          TRUE
            pass := FALSE
        result := #EEEE
    :
    --}}}
    SEQ
      --{{{  Initialise
      Pass := TRUE           -- Assume Device Okay Until Fault Found.
      Result := #EEEE        -- Not one of the Expected Values.
      --}}}
      --{{{  Result Gen
      Arg1 := 1
      Arg2 := 1
      SEQ i = 0 FOR BitsInWord
        SEQ
          Result := Arg1 + Arg2
          VerifyResult (Pass, Result, 2 << i)
          Arg1 := Arg1 << 1
          Arg2 := Arg1
      --}}}
      --{{{  Result Prop X
      INT Expected, Adjustment :  -- Used to generate the expected values.
      SEQ
        Adjustment := 3
        Expected   := 1
        Arg1      := 0
        Arg2      := 1
        SEQ i = 0 FOR BitsInWord
          SEQ
            Result := Arg1 + Arg2
            VerifyResult (Pass, Result, Expected)
            Expected := Expected + Adjustment
            Adjustment := Adjustment * 2
            Arg1 := (Arg1 << 1) + 1
            Arg2 := (Arg2 << 1) + 1
      --}}}
      --{{{  Result Prop Y
      INT Expected, Adjustment :  -- Used to generate the expected value
      SEQ
        Adjustment := 3
        Expected   := 1
        Arg1      := 1
        Arg2      := 0
        SEQ i = 0 FOR BitsInWord
          SEQ
            Result := Arg1 + Arg2
            VerifyResult (Pass, Result, Expected)
            Expected := Expected + Adjustment
            Adjustment := Adjustment * 2
            Arg1 := (Arg1 << 1) + 1
            Arg2 := (Arg2 << 1) + 1
      --}}}
      --{{{  Result Sub
      --{{{  TestArray
      VAL []INT TestArray IS
         [#FFFF, #8000, #4002, #2006, #100E, #081E, #043E, #027E,
          #01FE, #027E, #043E, #081E, #100E, #2006, #4002, #8000] :
      --}}}
      SEQ
        Arg1 := -1
        Arg2 :=  0
        SEQ i = 0 FOR BitsInWord
          SEQ
            Result := Arg1 + Arg2
            VerifyResult (Pass, Result, TestArray [i])
            Arg1 := (Arg1 >> 1)
            Arg2 := (Arg2 << 1) + 1
      --}}}
      --{{{  Test The Alu Logic
      --{{{  PROC LogicFunctions (VAL [6]INT TAIndex)
      PROC LogicFunctions (VAL [6]INT TAIndex)
        --{{{  TestArray
        VAL []INT TestArray IS [#5555, #0000, #AAAA, #FFFF, #3333, #CCCC] :
        --}}}
        --{{{  Comment
        -- TAIndex contains subscripts that Index into the TestArray.
        -- The first two elements of TAIndex identify the arguments that are used in
        -- the logic functions. The last four elements are used to identify expected
        -- bit patterns.
        --}}}
        SEQ
          Result := TestArray [ TAIndex[0] ] \/ TestArray [ TAIndex[1] ]
          VerifyResult (Pass, Result, TestArray [ TAIndex[2] ])
          Result := TestArray [ TAIndex[0] ] /\ TestArray [ TAIndex[1] ]
          VerifyResult (Pass, Result, TestArray [ TAIndex[3] ])
          Result := TestArray [ TAIndex[0] ] >< TestArray [ TAIndex[1] ]
          VerifyResult (Pass, Result, TestArray [ TAIndex[4] ])
          Result := ~ TestArray [ TAIndex[0] ]
          VerifyResult (Pass, Result, TestArray [ TAIndex[5] ])
      :
      --}}}
      SEQ
        LogicFunctions ([0, 0, 0, 0, 1, 2])
        LogicFunctions ([2, 0, 3, 1, 3, 0])
        LogicFunctions ([0, 2, 3, 1, 3, 2])
        LogicFunctions ([2, 2, 2, 2, 1, 0])
        LogicFunctions ([4, 4, 4, 4, 1, 5])
        LogicFunctions ([5, 4, 3, 1, 3, 4])
        LogicFunctions ([4, 5, 3, 1, 3, 5])
        LogicFunctions ([5, 5, 5, 5, 1, 4])
      --}}}
  :
  --}}}
  --{{{  StackT222C (BOOL Pass) 466
  PROC StackT222C (BOOL Pass)
  
    -- This checks the drivers connected to the stack and sets pass accordingly.
  
    --{{{  Definitions and Declarations
    VAL []INT TestArray IS [#2AAA, #5555, #AAAB, #AAAA, #8000] :
      --   The elements of this array are used in testing computed results
      -- against expected results.
    
    INT Result :
      -- This is used to compare a computed result against an expected value.
    --}}}
    --{{{  PROC VerifyResult (BOOL pass, INT result, VAL INT Expected)
    PROC VerifyResult (BOOL pass, INT result, VAL INT Expected)
    
      -- Every stack test requires a computed result to be tested against a known
      -- or expected value. This proc performs the testing.
      -- The proc sets pass if result differs from Expected.
    
      IF
        result = Expected
          SKIP
        TRUE
          pass := FALSE
    :
    --}}}
    INT event :
    PLACE event AT 8 :
    --{{{
    PROC Stackov (BOOL Pass)
      SEQ
    :
    --}}}
    SEQ
      --{{{  Initialise
      Pass := TRUE                   -- Assume part okay until fault found.
      Result := #EEEE            -- Any value not occurring in TestArray.
      --}}}
      --{{{  ShiftRightAreg
      GUY     --    check even bits
        LDC   #5555             -- load Areg
        STEP PROD               -- Areg := Areg >> 1
        LDC   0                 -- clear Oreg and push stack
        STL   Result            -- pop off Oreg
        STL   Result            -- store result of shift
      VerifyResult (Pass, Result, TestArray [0])
      
      GUY     -- check odd bits
        LDC   #AAAA             -- load Areg
        STEP PROD               -- Areg := Areg >> 1
        LDC   0                 -- clear Oreg and push stack
        STL   Result            -- pop off Oreg
        STL   Result            -- store result of shift
      VerifyResult (Pass, Result, TestArray [1])
      --}}}
      --{{{  ShiftRightBreg
      GUY     -- check even bits
        LDC   #5555             -- load Breg
        LDC   0                 -- load Areg
        --{{{  Step WCNTshiftPos  -- Breg := Breg >> 1
        PFIX  8
        PFIX #E
        OPR   9
        --}}}
        LDC   0                 -- clear Oreg and push stack
        STL   Result            -- pop off Oreg
        STL   Result            -- pop off Areg
        STL   Result            -- store result of shift
      VerifyResult (Pass, Result, TestArray [0])
      
      GUY     -- check odd bits
        LDC   #AAAA             -- load Breg
        LDC   0                 -- load Areg
        --{{{  Step WCNTshiftPos  -- Breg := Breg >> 1
        PFIX  8
        PFIX #E
        OPR   9
        --}}}
        LDC   0                 -- clear Oreg and push stack
        STL   Result            -- pop off Oreg
        STL   Result            -- pop off Areg
        STL   Result            -- store result of shift
      VerifyResult (Pass, Result, TestArray [1])
      --}}}
      --{{{  BregShIn0From1
      GUY
        LDC   0                 -- load Breg
        LDC   0                 -- load Areg
        --{{{  Step DIVlastBit1   -- Breg := (Breg << 1) + 1
        PFIX  9
        PFIX  4
        OPR   6
        --}}}
        LDC   0                 -- clear Oreg and push stack
        STL   Result            -- pop off Oreg
        STL   Result            -- pop off Areg
        STL   Result            -- store result of shift
      VerifyResult (Pass, Result, #0001)
      --}}}
      --{{{  ShiftLeftBreg
      GUY     -- check even bits
        LDC   #5555             -- load Breg
        LDC   0                 -- load Areg
        --{{{  Step DIVlastBit1   -- Breg := (Breg << 1) + 1
        PFIX  9
        PFIX  4
        OPR   6
        --}}}
        LDC   0                 -- clear Oreg and push stack
        STL   Result            -- pop off Oreg
        STL   Result            -- pop off Areg
        STL   Result            -- store result of shift
      VerifyResult (Pass, Result, TestArray [2])
      
      GUY     -- check odd bits
        LDC   #AAAA             -- load Breg
        LDC   0                 -- load Areg
        --{{{  Step DIVlastBit1   -- Breg := (Breg << 1) + 1
        PFIX  9
        PFIX  4
        OPR   6
        --}}}
        LDC   0                 -- clear Oreg and push stack
        STL   Result            -- pop off Oreg
        STL   Result            -- pop off Areg
        STL   Result            -- store result of shift
      VerifyResult (Pass, Result, TestArray [1])
      --}}}
      --{{{  ShiftLeftCreg   (YbusFromCregSL1)
      GUY     -- check even bits; shift in 0 to Creg[0]
        LDC   #5555             -- load Creg
        LDC   0                 -- load Breg
        LDC   0                 -- load Areg
        --{{{  Step NORMbitShLoop -- Creg := (Creg << 1) + Breg [31]
        PFIX  8
        PFIX #F
        OPR   5
        --}}}
        ADC   1                 -- clear Oreg
        STL   Result            -- pop off Areg
        STL   Result            -- pop off Breg
        STL   Result            -- store result of shift
      VerifyResult (Pass, Result, TestArray [3])
      
      GUY     -- check even bits; shift in 1 to Creg[0]
        LDC   #5555             -- load Creg
        MINT                    -- load Breg = #8000
        LDC   0                 -- load Areg
        --{{{  Step NORMbitShLoop -- Creg := (Creg << 1) + Breg [31]
        PFIX  8
        PFIX #F
        OPR   5
        --}}}
        ADC   1                 -- clear Oreg
        STL   Result            -- pop off Areg
        STL   Result            -- pop off Breg
        STL   Result            -- store result of shift
      VerifyResult (Pass, Result, TestArray [2])
      
      GUY     -- check odd bits; shift in 0 to Creg[0]
        LDC   #AAAA             -- load Creg
        LDC   0                 -- load Breg
        LDC   0                 -- load Areg
        --{{{  Step NORMbitShLoop -- Creg := (Creg << 1) + Breg [31]
        PFIX  8
        PFIX #F
        OPR   5
        --}}}
        ADC   1                 -- clear Oreg
        STL   Result            -- pop off Areg
        STL   Result            -- pop off Breg
        STL   Result            -- store result of shift
      VerifyResult (Pass, Result, #5554)
      
      GUY     -- check odd bits; shift in 1 to Creg[0]
        LDC   #AAAA             -- load Creg
        MINT                    -- load Breg = #8000
        LDC   0                 -- load Areg
        --{{{  Step NORMbitShLoop -- Creg := (Creg << 1) + Breg [31]
        PFIX  8
        PFIX #F
        OPR   5
        --}}}
        ADC   1                 -- clear Oreg
        STL   Result            -- pop off Areg
        STL   Result            -- pop off Breg
        STL   Result            -- store result of shift
      VerifyResult (Pass, Result, TestArray [1])
      --}}}
      --{{{  ShiftRightCreg  (CregFromZbusSR1)
      GUY     -- check even bits; shift in 0 to Creg[Msb]
        LDC   #5555              -- load Creg
        LDC   0                  -- load Breg
        LDC   0                  -- load Areg
        --{{{  Step NORMcountShift -- Creg := (Creg >> 1) + Cout << 31
        PFIX  9
        PFIX  0
        OPR   7
        --}}}
        ADC   1                  -- clear Oreg
        STL   Result             -- pop off Areg
        STL   Result             -- pop off Breg
        STL   Result             -- store result of shift
      VerifyResult (Pass, Result, TestArray [0])
      
      GUY     -- check even bits; shift in 1 to Creg[Msb]
        LDC   #5555              -- load Creg
        LDC   0                  -- load Breg
        LDC   0                  -- load Areg
        --{{{  Step NORMbitShEnd   -- Creg := (Creg >> 1) + 1
        PFIX  8
        PFIX #F
        OPR   7
        --}}}
        ADC   1                  -- clear Oreg
        STL   Result             -- pop off Areg
        STL   Result             -- pop off Breg
        STL   Result             -- store result of shift
      VerifyResult (Pass, Result, TestArray [3])
      
      GUY     -- check odd bits; shift in 0 to Creg[Msb]
        LDC   #AAAA              -- load Creg
        LDC   0                  -- load Breg
        LDC   0                  -- load Areg
        --{{{  Step NORMcountShift -- Creg := (Creg >> 1) + Cout << 31
        PFIX  9
        PFIX  0
        OPR   7
        --}}}
        ADC   1                  -- clear Oreg
        STL   Result             -- pop off Areg
        STL   Result             -- pop off Breg
        STL   Result             -- store result of shift
      VerifyResult (Pass, Result, TestArray [1])
      
      GUY     -- check odd bits; shift in 1 to Creg[Msb]
        LDC   #AAAA              -- load Creg
        LDC   0                  -- load Breg
        LDC   0                  -- load Areg
        --{{{  Step NORMbitShEnd   -- Creg := (Creg >> 1) + 1
        PFIX  8
        PFIX #F
        OPR   7
        --}}}
        ADC   1                  -- clear Oreg
        STL   Result             -- pop off Areg
        STL   Result             -- pop off Breg
        STL   Result             -- store result of shift
      VerifyResult (Pass, Result, #D555)
      --}}}
      --{{{  CregFrom0
      GUY
        LDC   #FFFF             -- load Creg
        LDC   0                 -- load Breg
        LDC   0                 -- load Areg
        STEP SB                 -- Creg := 0
        ADC   1                 -- clear Oreg
        STL   Result            -- pop off Areg
        STL   Result            -- pop off Breg
        STL   Result            -- store result
      VerifyResult (Pass, Result, 0)
      --}}}
      --{{{  CregShInMsbFromCarryOut
      GUY     -- force NOT CarryOut
        LDC   #FFFF             -- load Creg
        LDC   0                 -- load Breg
        LDC   0                 -- load Areg
        -- perform Areg + Creg in alu to give no CarryOut
        --{{{  Step LMULshiftAdd  -- Creg := (Creg >> 1) + COut << 31
        PFIX  9
        PFIX  3
        OPR  #B
        --}}}
        ADC   1                 -- clear Oreg
        STL   Result            -- pop off Areg
        STL   Result            -- pop off Breg
        STL   Result            -- store result of shift
      VerifyResult (Pass, Result, #7FFF)
      
      GUY     -- force CarryOut
        LDC   #FFFF             -- load Creg
        LDC   0                 -- load Breg
        LDC   1                 -- load Areg
        -- perform Areg + Creg in alu to give CarryOut
        --{{{  Step LMULshiftAdd  -- Creg := (Creg >> 1) + COut << 31
        PFIX  9
        PFIX  3
        OPR  #B
        --}}}
        ADC   1                 -- clear Oreg
        STL   Result            -- pop off Areg
        STL   Result            -- pop off Breg
        STL   Result            -- store result of shift
      VerifyResult (Pass, Result, TestArray [4])
      --}}}
      --{{{  CregShInMsbFromArithLogic
      --{{{  Comment
      -- multiply and add (MULshiftAdd) step shifts Creg right 1 place, and
      -- sign extends into Creg[msb] if there is no overflow from Areg + Creg,
      -- but sets NOT Zbus[msb] into Creg[msb] if there is an overflow from
      -- Areg + Creg.
      --}}}
      GUY     -- force no overflow, set Creg[msb] to 0 (from 0)
        LDC   #F                -- load Creg
        LDC   0                 -- load Breg
        LDC   0                 -- load Areg
        -- perform Areg + Creg in alu to give no Overflow
        --{{{  Step MULshiftAdd   -- Creg := ( (Cr + Ar) >> 1) + AL << 31
        PFIX  8
        PFIX  7
        OPR  #B
        --}}}
        ADC   1                 -- clear Oreg
        STL   Result            -- pop off Areg
        STL   Result            -- pop off Breg
        STL   Result            -- store result of shift
      VerifyResult (Pass, Result, #0007)
      
      GUY     -- force no overflow, set Creg[msb] to 1 (from 1)
        LDC   #FFFF             -- load Creg
        LDC   0                 -- load Breg
        LDC   #FFFF             -- load Areg
        -- perform Areg + Creg in alu to give no Overflow
        --{{{  Step MULshiftAdd   -- Creg := ( (Cr + Ar) >> 1) + AL << 31
        PFIX  8
        PFIX  7
        OPR  #B
        --}}}
        ADC   1                 -- clear Oreg
        STL   Result            -- pop off Areg
        STL   Result            -- pop off Breg
        STL   Result            -- store result of shift
      VerifyResult (Pass, Result, #FFFF)
      
      GUY     -- force overflow, set Creg[msb] to 0 (from 1)
        MINT                    -- load Creg = #8000
        LDC   0                 -- load Breg
        MINT                    -- load Areg = #8000
        -- perform Areg + Creg in alu to give Overflow
        --{{{  Step MULshiftAdd   -- Creg := ( (Cr + Ar) >> 1) + AL << 31
        PFIX  8
        PFIX  7
        OPR  #B
        --}}}
        ADC   1                 -- clear Oreg
        STL   Result            -- pop off Areg
        STL   Result            -- pop off Breg
        STL   Result            -- store result of shift
      VerifyResult (Pass, Result, TestArray [4])
      
      GUY     -- force overflow, set Creg[msb] to 1 (from 0)
        LDC   #5555             -- load Creg
        LDC   0                 -- load Breg
        LDC   #7FFF             -- load Areg
        -- perform Areg + Creg in alu to give Overflow
        --{{{  Step MULshiftAdd   -- Creg := ( (Cr + Ar) >> 1) + AL << 31
        PFIX  8
        PFIX  7
        OPR  #B
        --}}}
        ADC   1                 -- clear Oreg
        STL   Result            -- pop off Areg
        STL   Result            -- pop off Breg
        STL   Result             -- store result of shift
      VerifyResult (Pass, Result, #6AAA)
      --}}}
  :
  --}}}

  --{{{  OUTPUT channel declarations
  CHAN OF ANY OUTPUT0 :
  PLACE OUTPUT0 AT 0 :
  CHAN OF ANY OUTPUT1 :
  PLACE OUTPUT1 AT 1 :
  CHAN OF ANY OUTPUT2 :
  PLACE OUTPUT2 AT 2 :
  CHAN OF ANY OUTPUT3 :
  PLACE OUTPUT3 AT 3 :
  [4]CHAN OF ANY OUTPUT IS [OUTPUT0, OUTPUT1, OUTPUT2, OUTPUT3] :
  --}}}
  CHAN OF INT16::[]BYTE out IS OUTPUT[boot] :
  BOOL pass :
  [20]BYTE message :
  SEQ
    --{{{  Data path
    VAL mess IS "?Integer Datapath" :
    SEQ
      [message FROM 0 FOR SIZE mess] := mess
      DpathT222C(pass)
      IF
        pass
          message[0] := ' '
        TRUE
          SKIP
      out ! (INT16 (SIZE mess))::message
    --}}}
    --{{{  ALU
    VAL mess IS "?Integer ALU" :
    SEQ
      [message FROM 0 FOR SIZE mess] := mess
      AluT222C(pass)
      IF
        pass
          message[0] := ' '
        TRUE
          SKIP
      out ! (INT16 (SIZE mess))::message
    --}}}
    --{{{  Stack
    VAL mess IS "?Stack drivers" :
    SEQ
      [message FROM 0 FOR SIZE mess] := mess
      StackT222C(pass)
      IF
        pass
          message[0] := ' '
        TRUE
          SKIP
      out ! (INT16 (SIZE mess))::message
    --}}}
    out ! 1(INT16)::"."
    GUY
      OPR $1FF
:

--
--  eof
--
