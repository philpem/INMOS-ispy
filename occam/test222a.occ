
-- --------------------------------------------------
--
--    test222a.occ  --  T2 test code
--
-- --------------------------------------------------



#INCLUDE "checklib.occ"
PROC test222a(VAL INT boot)
  --{{{  TimeT222C  (BOOL Pass)
  PROC TimeT222C (BOOL Pass)
  
    --{{{  Comment
    --   Version to check variation in time results do not hide uncertainty.
    
    --   Test timer can increment, can cause interrupts from any bit position in
    -- comparator registers, and gives correct count in processor cycles.
    --   Check that the timeout occurs once every 1 to 2 millisecs at low
    -- priority only, by using the processor to monitor the length of time taken
    -- in a loop; do not write all loop times to memory due to uncertainty of
    -- timeout relative to processor.
    
    --   Note that the unused timer does not cause interrupts every 24 hrs.
    -- on T414b.
    
    --   High priority timer (ticks at full rate)
    --   Low priority timer (ticks at 1/64 of full rate)
    --}}}
    --{{{  Decs
    TIMER Clock :
    
    VAL BitsInWord IS 16 :
    
    VAL INT LowPriTicks IS 64 :     --   Low Pri Clock 64 times slower than High
                                    -- Pri clock.
    
    VAL INT ErroneousSpeed IS -1 :  --   Used to initialise Cycles Per Tick.
    
    INT Result, Expected :
      -- These are used to compare a computed result against an expected value.
    
    INT CyclesPerTick :          -- Indicates the speed at which the part is
                                 -- running.
    --}}}
    --{{{  PROC VerifyResult (BOOL pass, INT result, VAL INT Expected)
    PROC VerifyResult (BOOL pass, INT result, VAL INT expected)
    
      -- Due to the inherent uncertainties in measuring times all tests are
      -- achieved by looking at differences between a timer input and an expected
      -- value and comparing this difference to a given tolerance.
      -- This proc performs the testing.
      -- The proc sets pass if result differs from expected.
    
      VAL INT DeltaTime IS 2 :   -- Amount of tolerance
      INT TimeDiff :
      SEQ
        --{{{  Set TimeDiff
        IF
          expected > result
            TimeDiff := expected MINUS result
          TRUE
            TimeDiff := result MINUS expected
        --}}}
        IF
          TimeDiff <= DeltaTime
            SKIP
          TRUE
            pass := FALSE
    :
    --}}}
    --{{{  PROC DetermineSpeed (INT Speed)
    PROC DetermineSpeed (INT Speed)
    
      -- Determines the CyclesPerTick of the Device under test.
    
      TIMER Clock :
      INT Before, After, Ticks :
      SEQ
        Clock ? Before
        --{{{  Delay by 256000 Cycles
        GUY
          LDC    1
          --{{{
          LDC 32000
          SHL
          --}}}
          --{{{
          LDC 32000
          SHL
          --}}}
          --{{{
          LDC 32000
          SHL
          --}}}
          --{{{
          LDC 32000
          SHL
          --}}}
          --{{{
          LDC 32000
          SHL
          --}}}
          --{{{
          LDC 32000
          SHL
          --}}}
          --{{{
          LDC 32000
          SHL
          --}}}
          --{{{
          LDC 32000
          SHL
          --}}}
        --}}}
        Clock ? After
        Ticks := After MINUS Before
        VAL []INT TicksArray IS [200, 267, 228, 178, 333, 160, 133] :
        VAL []INT SpeedArray IS [ 20,  15,  17,  22,  12,  25,  30] :
        --{{{  INT FUNCTION Modulus (VAL INT Arg)
        INT FUNCTION Modulus (VAL INT Arg)
          INT Pos :
          VALOF
            IF
              Arg < 0
                Pos := (-Arg)
              TRUE
                Pos := Arg
            RESULT Pos
        :
        --}}}
        INT TimeDiff :
        SEQ i = 0 FOR (SIZE SpeedArray)
          SEQ
            TimeDiff := Modulus (Ticks - TicksArray [i])
            IF
              TimeDiff <= 2
                Speed := SpeedArray [i]
              TRUE
                SKIP
    :
    --}}}
    SEQ
      --{{{  Initialise
      Pass     := TRUE           -- Assume Device Okay Until Fault Found.
      Result   := #EEEE          -- Not one of the Expected Values.
      CyclesPerTick := ErroneousSpeed
      DetermineSpeed (CyclesPerTick)
      --}}}
      IF
        --{{{  Speed Definitely Incorrect Set Pass to False and Finish
        CyclesPerTick = ErroneousSpeed
          Pass := FALSE
        --}}}
        --{{{  Otherwise do the rest of the tests.
        TRUE
          SEQ
            --{{{  Clear the STATUS register
            -- first clear the STATUSreg to ensure that the .dmp file is consistent
            -- for all parts (powers up with error and/or single step bits set)
            GUY
              LDC   0
              TESTSTS             -- clear non-single-step bits
              STEP REV            -- clear single-step bits
              LDC   0             -- clear Oreg and push stack
            --}}}
            --{{{  Check that the high and low clock registers increment asynchronously
            VAL INT NumberOfTicks IS 6 :
            PRI PAR
              --{{{  Check each bit of HCLOCKreg increments asynchronously
              SEQ i = 0 FOR BitsInWord
                INT Source, TimeDiff :
                SEQ
                  Source := (1 << i) - 3
                  --{{{  Increment HClock from known bit pattern and wait for given time
                  INT ShiftConstant :
                  SEQ
                    ShiftConstant := NumberOfTicks * CyclesPerTick  -- Approx 6 Hi Pri Tick
                    --{{{  Make up the half for -17 and -22 parts
                    VAL INT Adjustment IS NumberOfTicks / 2 :
                    IF
                      (CyclesPerTick = 17) OR (CyclesPerTick =22)
                        ShiftConstant := ShiftConstant + Adjustment
                      TRUE
                        SKIP
                    --}}}
                    GUY
                      LDL   Source
                      STTIMER
                      -- wait for at least 4 ticks, but less than 8 ticks,
                      -- to allow for +/- 2 tick uncertainty
                      --{{{  Wait for Approximately 6 High Pri Ticks (Error + or - 2)
                      LDC  1
                      LDL  ShiftConstant
                      SHL
                      --}}}
                  --}}}
                  Clock ? Result
                  TimeDiff := Result - Source
                  IF
                    --{{{  Possibly Correct
                    (TimeDiff >= 4) AND (TimeDiff <= 8)    -- May be correct result
                      SEQ
                        Expected := (1 << i) + 3
                        VerifyResult (Pass, Result, Expected)
                    --}}}
                    --{{{  Definitely InCorrect
                    TRUE                                   -- Did not increment correctly
                      Pass := FALSE
                    --}}}
              --}}}
              --{{{  Check each bit of LCLOCKreg increments asynchronously
              SEQ i = 0 FOR BitsInWord
                INT Source, TimeDiff :
                SEQ
                  Source := (1 << i) - 3
                  --{{{  Increment LClock from known bit and wait for given time.
                  INT ShiftConstant :
                  SEQ
                    ShiftConstant := (NumberOfTicks * LowPriTicks) * CyclesPerTick
                                                        -- Approximately 6 LowPri Ticks
                    --{{{  Make up the half for -17 and -22 parts
                    VAL INT Adjustment IS (NumberOfTicks * LowPriTicks) / 2 :
                    IF
                      (CyclesPerTick = 17) OR (CyclesPerTick =22)
                        ShiftConstant := ShiftConstant + Adjustment
                      TRUE
                        SKIP
                    --}}}
                    GUY
                      LDL   Source
                      STTIMER
                      --{{{  Wait for Approximately 6 Low Pri Ticks (Error + or - 2)
                      LDC  1
                      LDL  ShiftConstant
                      SHL
                      --}}}
                  --}}}
                  Clock ? Result
                  TimeDiff := Result - Source
                  IF
                    --{{{  Possibly Correct
                    (TimeDiff >= 4) AND (TimeDiff <= 8)       -- Correct TimeDiff
                      SEQ
                        Expected := ( 1 << i  ) + 3
                        VerifyResult (Pass, Result, Expected)
                    --}}}
                    --{{{  Definitely InCorrect
                    TRUE                          -- Did not increment correctly
                      Pass := FALSE
                    --}}}
              --}}}
            --}}}
            --{{{  Check each bit of low  pri timer comparator register
            -- Causes a timer interrupt
            -- low priority timer (ticks at 1/64 of full rate)
            SEQ i = 0 FOR BitsInWord
              INT Source :
              SEQ
                Source := (1 << i) - #1   -- allow time to set up timer input
                --{{{  Start Timer from Source
                GUY
                  LDL   Source
                  STTIMER
                --}}}
                Clock ? AFTER Source + #1  -- wait until after bit position reached
                Clock ? Result
                Expected := (1 << i) + 1
                VerifyResult (Pass, Result, Expected)
            --}}}
            --{{{  Check each bit of high pri timer comparator register
            -- check each bit of the high priority timer comparator register
            -- causes a timer interrupt due to equality in the comparator.
            PRI PAR
              --{{{  High Pri Timer
              SEQ i = 0 FOR BitsInWord
                INT Source :
                SEQ
                  Source := (1 << i) - #10          -- allow time to set up timer input
                  --{{{  Start Timer from Source
                  GUY
                    LDL   Source
                    STTIMER
                  --}}}
                  Clock ? AFTER Source + #10        -- wait until after bit position reached
                  Clock ? Result
                  Expected := (1 << i) + 3
                  VerifyResult (Pass, Result, Expected)
              --}}}
              SKIP
            --}}}
            --{{{  Check time measurements against number of executed cycles
            PRI PAR
              --{{{  High Pri Timer
              VAL INT NumberOfTicks IS #0084 :
              INT Before, After, ShiftConstant :
              SEQ
                ShiftConstant := CyclesPerTick * NumberOfTicks
                --{{{  Make up the half for -17 and -22 parts
                VAL INT Adjustment IS NumberOfTicks / 2 :
                IF
                  (CyclesPerTick = 17) OR (CyclesPerTick = 22)
                    ShiftConstant := ShiftConstant + Adjustment
                  TRUE
                    SKIP
                --}}}
                Clock ? Before
                --{{{  Delay by known amount
                GUY
                  LDC  1
                  LDL  ShiftConstant        -- Produce NumberofTicks In Timer Reg
                  SHL
                --}}}
                Clock ? After
                Result := After MINUS Before
                VerifyResult (Pass, Result, NumberOfTicks)
              --}}}
              --{{{  Low Pri Timer
              VAL INT NumberOfTicks IS 12 :
              
                --   This constant has to be changed for T2's as the shift constant will
                -- overflow. Require,  NumberOfTicks <  MaxInt / (CyclesPerTick * 64).
              
              INT Before, After, ShiftConstant :
              SEQ
                ShiftConstant := (CyclesPerTick * NumberOfTicks) * LowPriTicks
                --{{{  Make up the half for -17 and -22 parts
                VAL INT Adjustment IS (NumberOfTicks * LowPriTicks) / 2 :
                IF
                  (CyclesPerTick = 17) OR (CyclesPerTick =22)
                    ShiftConstant := ShiftConstant + Adjustment
                  TRUE
                    SKIP
                --}}}
                Clock ? Before
                --{{{  Delay by known amount
                GUY
                  LDC 1
                  LDL ShiftConstant        -- Produce NumberOfTicks in Timer Reg.
                  SHL
                --}}}
                Clock ? After
                Result := After MINUS Before
                VerifyResult (Pass, Result, NumberOfTicks)
              --}}}
            --}}}
            --{{{  Check that Timeslicing occurs correctly
            VAL INT TimeOutLoop IS #7FFF :  -- Big enough to ensure a timeslice.
                                            -- MaxInt for 16 Bit machines.
            INT x, y  :
            BOOL fail :
            SEQ
              --{{{  Check time out does occur at low priority.
              x, y := 0, 0
              fail := FALSE
              PAR
                SEQ
                  --{{{  Increment x in loop
                  SEQ i = 0 FOR TimeOutLoop   -- Loop subject to timeslice.
                    x := x + 1
                  --}}}
                  --{{{  Fail if y = 0
                  IF
                    y = 0
                      fail := TRUE
                    TRUE
                      SKIP
                  --}}}
                SEQ
                  --{{{  Increment y in loop
                  SEQ i = 0 FOR TimeOutLoop   -- Loop subject to timeslice.
                    y := y + 1
                  --}}}
                  --{{{  Fail if x = 0
                  IF
                    x = 0
                      fail := TRUE
                    TRUE
                      SKIP
                  --}}}
              Pass := Pass AND (NOT fail)
              --}}}
              --{{{  Check time out does not occur at high priority.
              INT x1, x2, otherx1, otherx2, y :
              SEQ
                x1, x2, y := 0, 0, 0
                PRI PAR
                  --{{{  Loops Should Not Time Slice
                  SEQ
                    PAR
                      SEQ
                        SEQ i = 0 FOR TimeOutLoop
                          x1 := x1 + 1
                        otherx1 := x2
                      SEQ
                        SEQ i = 0 FOR TimeOutLoop
                          x2 := x2 + 1
                        otherx2 := x1
                    Pass := Pass AND (y = 0)
                  --}}}
                  --{{{  Loops Should Time Slice
                  SEQ
                    SEQ i = 0 FOR TimeOutLoop
                      y := y + 1
                    IF
                      (otherx1 = 0) AND (otherx2 = TimeOutLoop) AND
                       (x1 = TimeOutLoop) AND (x2 = TimeOutLoop)
                        SKIP
                      (otherx2 = 0) AND (otherx1 = TimeOutLoop) AND
                       (x1 = TimeOutLoop) AND (x2 = TimeOutLoop)
                        SKIP
                      TRUE
                        Pass := FALSE
                  --}}}
              --}}}
            --}}}
            --{{{  Clear Error
            GUY
              TESTERR
            --}}}
        --}}}
  :
  --}}}
  --{{{  CmuxT222C  (BOOL Pass) 798
  PROC CmuxT222C (BOOL Pass)
  
    -- This checks all the ConditionalMultiplexers not dependent on pins
    -- and sets Pass accordingly.
  
    --{{{  Definitions and Declaration
    VAL []INT TestArray IS [#0000, #2000, #4000, #6000] :
      -- Under certain conditions exercising a conditional multiplexer produces
      -- one of these values.
    
    INT Result :
      -- This is used to compare a computed result against an expected value.
    --}}}
  
    --{{{  PROC VerifyResult (BOOL pass, INT result, VAL INT Expected)
    PROC VerifyResult (BOOL pass, INT result, VAL INT Expected)
    
      -- Every cmux test requires a computed result to be tested against a known
      -- or expected value. This proc performs the testing.
      -- The proc sets pass if result differs from Expected and resets result.
      -- result is reset for the following reason. Some adjacent Cmux1 tests
      -- require the same expected values. If for any reason result failed to be
      -- re-assigned the next test might indicate a pass irrespective of whether
      -- the cmux was functioning correctly.
    
      SEQ
    
        IF
          result = Expected
            SKIP
          TRUE
            pass := FALSE
    
        result := #EEEE     -- Any value not occurring in TestArray.
    :
    --}}}
    SEQ
      --{{{  Initialise
      Pass := TRUE                   -- Assume part okay until fault found.
      Result := #EEEE            -- Any value not occurring in TestArray.
      --{{{  Clear the Staus Register
      GUY
        LDC   0
        TESTSTS               -- clear STATUSreg
      --}}}
      --}}}
      --{{{  CMux0
      --{{{  Cond0FromNotCarryOut               #B001
      GUY
        LDC   0               -- load Creg
        LDC   0               -- load Breg
        LDC   0               -- load Areg
        --{{{  Step LSUMadd     -- Force NOT CarryOut
        PFIX   9
        PFIX   0
        OPR   #A
        --}}}
        LDC   0               -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [3])
      
      GUY
        LDC   0               -- load Creg = 0
        LDC   #FFFF           -- load Breg = -1
        MINT                  -- load Areg = #8000
        --{{{  Step LSUMadd     -- Force CarryOut
        PFIX   9
        PFIX   0
        OPR   #A
        --}}}
        LDC   0               -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [2])
      --}}}
      --{{{  Cond0FromNotZbusSubLessThan0       #B010
      GUY
        LDC   0               -- load Creg
        LDC   0               -- load Breg
        LDC   0               -- load Areg
        STEP GT               -- Force NOT ZbusSubLessThan0;
        LDC   0               -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [3])
      
      GUY
        LDC   0               -- load Creg
        LDC   1               -- load Breg
        LDC   0               -- load Areg
        STEP GT               -- Force ZbusSubLessThan0;
        LDC   0               -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [2])
      --}}}
      --{{{  Cond0FromNotAluPropAll1            #B011
      
      --   Cond0FromNotZbusEq0     = Cond0FromNotAluPropAll1 ;
      
      GUY
        LDC   1               -- load Areg
        STEP SHL              -- Force NOT ZbusEq0;
        LDC   0               -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [1])
      
      GUY
        LDC   0               -- load Areg
        STEP SHL              -- Force ZbusEq0;
        LDC   0               -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [0])
      --}}}
      --{{{  Cond0FromOverflow                  #B100
      -- Not Used.
      -- Included for completeness.
      --}}}
      --{{{  Cond0FromNotIncOregCarryOut        #B101
      GUY
      
        --    Cond0FromNotLastRead    = Cond0FromNotIncOregCarryOut
      
        LDC   0                        -- load Creg
        LDC   0                        -- load Breg
        LDC   0                        -- load Areg
        --{{{  Step MOVEformWriteCount   -- Force NOT IncOregCarryOut
        PFIX  #A
        PFIX   2
        OPR   #C
        --}}}
        LDC   0                        -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [3])
      
        -- cannot force IncOregCarryOut through single stepping, because
        -- Oreg is used to form microword address; this is observable through
        -- move1.hex to move12.hex.
        -- If IncOregCarryOut is asserted in a single-stepped microword, then
        -- the Oregister is loaded both from the incrementer and from the
        -- next operand at the same time (ie Gnd and Vdd shorted through 2 NEs).
      --}}}
      --{{{  Cond0FromNotIncDregCarryOut        #B110
      GUY
      
        --    Cond0FromNotLastWrite = Cond0FromNotIncDregCarryOut
      
        LDC   0                 -- load Areg
        TESTSTD
        --{{{  Step WCNTshiftPos  -- Force NOT IncDregCarryOut
        PFIX   8
        PFIX  #E
        OPR    9
        --}}}
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [1])
      
      GUY
        LDC   #FFFF         -- load Areg
        TESTSTD
        --{{{  Step WCNTshiftPos  -- Force IncDregCarryOut
        PFIX   8
        PFIX  #E
        OPR    9
        --}}}
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [0])
      --}}}
      --{{{  Cond0FromNotPrInAnalyse            #B111
      -- Depends on whether AnalysePad has been asserted
      -- Not relevant in this context.
      --}}}
      --}}}
      --{{{  CMux1
      --{{{  Cond1FromDivStep0                  #B0001
      --{{{  Comment
        -- DivStep0 = ~(aluCarryOut >< CslaveMSB)
        -- use DIVloopAdd (Cond1FromDivStep0, Cond0FromNotIncDregCarryOut)
        -- alu performs (Creg<<1) + Areg; test DivStep logic xor
      --}}}
      
      GUY
        LDC   0
        TESTSTD               -- load Dreg
        MINT                  -- load Creg #8000
        LDC   0               -- load Breg
        LDC   0               -- load Areg
        --{{{  StepDIVloopAdd   -- Force NOT DivStep0 : Creg[msb] & NOT AluCarryOut
        PFIX   9
        PFIX   4
        OPR    5
        --}}}
        LDC   0               -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [1])
      
      GUY
        LDC   0
        TESTSTD               -- load Dreg
        LDC   #7000           -- load Creg
        LDC   0               -- load Breg
        MINT                  -- load Areg #8000
        --{{{  StepDIVloopAdd   -- Force NOT DivStep0 : NOT Creg[msb] & AluCarryOut
        PFIX   9
        PFIX   4
        OPR    5
        --}}}
        LDC   0               -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [1])
      
      GUY
        LDC   0
        TESTSTD               -- load Dreg
        LDC   0               -- load Creg
        LDC   0               -- load Breg
        LDC   0               -- load Areg
        --{{{  StepDIVloopAdd   -- Force DivStep0 : NOT Creg[msb] & NOT AluCarryOut
        PFIX   9
        PFIX   4
        OPR    5
        --}}}
        LDC   0               -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [3])
      
      GUY
        LDC   0
        TESTSTD               -- load Dreg
        LDC   #F000           -- load Creg
        LDC   0               -- load Breg
        MINT                  -- load Areg #8000
        --{{{  StepDIVloopAdd   -- Force DivStep0 : Creg[msb] & AluCarryOut
        PFIX   9
        PFIX   4
        OPR    5
        --}}}
        LDC   0               -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [3])
      --}}}
      --{{{  Cond1FromDivStep1                  #B0010
      --{{{  Comment
        -- DivStep1 = aluCarryOut >< CslaveMSB
        -- use DIVloopSub (Cond1FromDivStep1, Cond0FromNotIncDregCarryOut)
        -- alu performs (Creg<<1) - Areg; DivStep logic xor tested above
      --}}}
      
      GUY
        LDC   0
        TESTSTD                 -- load Dreg
        MINT                    -- load Creg #8000
        LDC   0                 -- load Breg
        LDC   0                 -- load Areg
        --{{{  Step DIVloopSub    -- Force NOT DivStep1 : Creg[msb] & AluCarryOut
        PFIX   9
        PFIX   4
        OPR    7
        --}}}
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [1])
      
      GUY
        LDC   0
        TESTSTD                 -- load Dreg
        LDC   0                 -- load Creg
        LDC   0                 -- load Breg
        LDC   0                 -- load Areg
        --{{{  Step DIVloopSub    -- Force DivStep1 : NOT Creg[msb] & AluCarryOut
        PFIX   9
        PFIX   4
        OPR    7
        --}}}
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [3])
      --}}}
      --{{{  Cond1FromAslave0                   #B0011
      GUY
        LDC   0                 -- load Areg
        STEP PROD               -- Force NOT Aslave0;
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [1])
      
      GUY
        LDC   1                 -- load Areg
        STEP PROD               -- Force Aslave0;
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [3])
      --}}}
      --{{{  Cond1FromBslave0                   #B0100
      GUY
        LDC   0                 -- load Breg
        LDC   0                 -- load Areg
        --{{{  Step MulinitLoop   -- Force NOT Bslave0
        PFIX  #A
        PFIX   3
        OPR    7
        --}}}
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [1])
      
      GUY
        LDC   1                 -- load Breg
        LDC   0                 -- load Areg
        --{{{  Step MulinitLoop   -- Force Bslave0
        PFIX  #A
        PFIX   3
        OPR    7
        --}}}
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [3])
      --}}}
      --{{{  Cond1fromBslave1                   #B0101
      GUY
        LDC   0
        TESTSTD                 -- load Dreg
        LDC   0                 -- load Breg
        LDC   0                 -- load Areg
        --{{{  Step MULshift      -- Force NOT Bslave1
        PFIX   8
        PFIX   7
        OPR    9
        --}}}
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [1])
      
      GUY
        LDC   0
        TESTSTD                 -- load Dreg
        LDC   2                 -- load Breg
        LDC   0                 -- load Areg
        --{{{  Step MULshift      -- Force Bslave1
        PFIX   8
        PFIX   7
        OPR    9
        --}}}
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [3])
      --}}}
      --{{{  Cond1FromBslaveMsb                 #B0110
      GUY
        LDC   0                 -- load Breg
        LDC   0                 -- load Areg
        --{{{  Step WCNTtestSign  -- Force NOT BslaveMSB
        PFIX   9
        PFIX  #D
        OPR    6
        --}}}
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [1])
      
      GUY
        MINT                    -- load Breg #8000
        LDC   0                 -- load Areg
        --{{{  Step WCNTtestSign  -- Force BslaveMSB
        PFIX   9
        PFIX  #D
        OPR    6
        --}}}
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [3])
      --}}}
      --{{{  Cond1FromCslaveMsb                 #B0111
      GUY
        LDC   0                 -- load Creg
        LDC   0                 -- load Breg
        LDC   0                 -- load Areg
        --{{{  Step NORMbitShLoop -- Force NOT CslaveMSB
        PFIX   8
        PFIX  #F
        OPR    5
        --}}}
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [1])
      
      GUY
        MINT                    -- load Creg #8000
        LDC   0                 -- load Breg
        LDC   0                 -- load Areg
        --{{{  Step NORMbitShLoop -- Force CslaveMSB
        PFIX   8
        PFIX  #F
        OPR    5
        --}}}
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [3])
      --}}}
      --{{{  Cond1FromNotTwoReadsToStart        #B1000
      --{{{  Comment
        -- TwoReadsToStart := SB > DB    (Creg=Source, Breg=Dest)
        -- the TwoReadsToStart logic is tested by move.hex
      --}}}
      GUY
        LDC   0                 -- load Creg
        LDC   0                 -- load Breg
        LDC   0                 -- load Areg
        --{{{  Step MOVEintr      -- Force NOT TwoReadsToStart
        PFIX   8
        PFIX   8
        OPR   #F
        --}}}
        LDC   0                 -- clear Oreg and push stack
        LDC   0
        TESTSTS                 -- clear MoveBit
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [2])
      
      GUY
        LDC   1                 -- load Creg
        LDC   0                 -- load Breg
        LDC   0                 -- load Areg
        --{{{  Step MOVEintr      -- Force TwoReadsToStart
        PFIX   8
        PFIX   8
        OPR   #F
        --}}}
        LDC   0                 -- clear Oreg and push stack
        LDC   0
        TESTSTS                 -- clear MoveBit
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [0])
      --}}}
      --{{{  Cond1FromProcPriority              #B1001
      GUY                       -- ****     Change to high priority    ****
        LDLP  0
        STEP GAJW
        LDC   0                 -- clear Oreg and push stack
        --{{{  Step GAJWnewWdescH -- Make High Priority
        PFIX   8
        PFIX  #D
        OPR    5
        --}}}
        LDC   0                 -- clear Oreg and push stack
        -- check that priority bit is sensitive to being reset and set
        -- now at high priority
        STEP GAJW
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [1])
      
      GUY                       -- ****     Change to high priority    ****
        LDLP  0
        STEP GAJW
        LDC   0                 -- clear Oreg and push stack
        --{{{  Step GAJWnewWdescL -- Make Low Priority
        PFIX   8
        PFIX  #D
        OPR    7
        --}}}
        LDC   0                 -- clear Oreg and push stack
        -- check that priority bit is sensitive to being reset and set
        -- now at low priority
        STEP GAJW
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [3])
      --}}}
      --{{{  Cond1FromChOrTimerReq              #B1011
        -- Only used in idle loop (SNPdoBusyWait).
        --
        -- If SNPdoBusyWait is stepped, then single step bit is set, and forces
        -- processor to low priority; therefore timer interrupts and is single
        -- stepped, clearing the alarm and using Dreg and Ereg.
      
      --}}}
      --{{{  Cond1FromChNotTimerReq             #B1100
      GUY
        -- check ChNotTimerReq is not stuck high;
        --{{{  Step START1stByteWait
        PFIX   8
        PFIX   6
        OPR    9
        --}}}
        LDC   0                    -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [1])
      
        -- check ChNotTimerReq not high for timer req;
      GUY                       -- ****     Change to high priority    ****
        LDLP  0
        STEP GAJW
        LDC   0                 -- clear Oreg and push stack
        --{{{  Step GAJWnewWdescH -- Make High Priority
        PFIX   8
        PFIX  #D
        OPR    5
        --}}}
        LDC   0                 -- clear Oreg and push stack
      
        -- set low timer alarm
        LDC   #1234
        STTIMER
        LDC   #1235
        STEP GAJW               -- DATAreg := Areg
        LDC   0                 -- clear Oreg and push stack
        --{{{  Step INSnextLT     -- LTIMERreg := DATAreg and Enable Alarm
        PFIX   8
        PFIX  #A
        OPR   #E
        --}}}
        LDC   0                 -- clear Oreg and push stack
        --{{{  Step START1stByteWait
        PFIX   8
        PFIX   6
        OPR    9
        --}}}
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [1])
      
        -- timer interrupt routine will clear alarm, but there must be
        -- a valid timer to run; therefore force a timer disable to
        -- remove the alarm.
      GUY                       -- ****     Change to low priority    ****
        --{{{  Step INSendLTaddr  -- Disable Low Priority Timer.
        PFIX   8
        PFIX  #D
        OPR    6
        --}}}
        LDC   0                 -- clear Oreg and push stack
        LDL   0                 -- cause LTimerPtr Read in INSendLTaddr to finish
        LDLP  0
        STEP GAJW
        LDC   0                 -- clear Oreg and push stack
        --{{{  Step GAJWnewWdescL -- Make Low Priority
        PFIX   8
        PFIX  #D
        OPR    7
        --}}}
        LDC   0                 -- clear Oreg and push stack
      --}}}
      --{{{  Cond1FromHighNotLowReq             #B1101
      --{{{  Comment
        -- cannot make high priority request without it being
        -- serviced; can make low priority request at high priority.
      --}}}
      GUY
        -- check HighNotLowReq is not stuck high;
        --{{{  Step INStestIntr
        PFIX   8
        PFIX   7
        OPR   #E
        --}}}
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [1])
      
        -- check HighNotLowReq not high for low pr req;
      GUY                       -- ****     Change to high priority    ****
        LDLP  0
        STEP GAJW
        LDC   0                 -- clear Oreg and push stack
        --{{{  Step GAJWnewWdescH -- Make High Priority
        PFIX   8
        PFIX  #D
        OPR    5
        --}}}
        LDC   0                 -- clear Oreg and push stack
        -- set low timer alarm
        LDC   #4453
        STTIMER
        LDC   #7786
        STEP GAJW               -- DATAreg := Areg
        LDC   0                 -- clear Oreg and push stack
        --{{{  Step INSnextLT     -- LTIMERreg := DATAreg and Enable Alarm
        PFIX   8
        PFIX  #A
        OPR   #E
        --}}}
        LDC   0                 -- clear Oreg and push stack
        --{{{  Step INStestIntr
        PFIX   8
        PFIX   7
        OPR   #E
        --}}}
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [0])
      
        -- timer interrupt routine will clear alarm, but there must be
        -- a valid timer to run; therefore force a timer disable to
        -- remove the alarm.
      GUY
        --{{{  Step INSendLTaddr  -- Disable Low Priority Timer.
        PFIX   8
        PFIX  #D
        OPR    6
        --}}}
        LDC   0                 -- clear Oreg and push stack
        LDL   0                 -- cause LTimerPtr Read in INSendLTaddr to finish
        LDLP  0                 -- ****     Change to low priority    ****
        STEP GAJW
        LDC   0                 -- clear Oreg and push stack
        --{{{  Step GAJWnewWdescL -- Make Low Priority
        PFIX   8
        PFIX  #D
        OPR    7
        --}}}
        LDC   0                 -- clear Oreg and push stack
      --}}}
      --{{{  Cond1FromBootFromRomNotLinks       #B1010
        -- Dependent upon BootFromRomPin.
        -- Not relevant in this context.
      --}}}
      --{{{  Cond1FromChannelReadyNotRun        #B1110
        -- Need hard channel message and ALT to test ReadyNotRun logic.
        -- Not relevant in this context.
      --}}}
      --{{{  Cond1FromTimeOutReq                #B1111
      --{{{  Comment
        -- can single step J;
        -- must have two negative edges on CLOCKslave[9] to set time out
      --}}}
      GUY                       -- first ensure that time out latch is reset
        --{{{  Step SNPlow        -- ResetTimeOut
        PFIX   8
        PFIX  #A
        OPR   #F
        --}}}
        LDC   0                 -- clear Oreg and push stack
        --{{{  TESTstepTimeOut
        PFIX   9
        PFIX   9
        OPR   #B
        --}}}
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [0])
      
      GUY                       -- Force time out
        LDC   #FFFF
        STTIMER
        LDC   0
        STTIMER
        LDC   #FFFF
        STTIMER
        LDC   0
        STTIMER
        --{{{  TESTstepTimeOut
        PFIX   9
        PFIX   9
        OPR   #B
        --}}}
        LDC   0                 -- clear Oreg and push stack
        TESTLDS
        STL   Result
      VerifyResult (Pass, Result, TestArray [2])
      --}}}
      --}}}
  :
  --}}}
  --{{{  OUTPUT channel DECLs
  CHAN OF ANY OUTPUT0 :
  PLACE OUTPUT0 AT 0 :
  CHAN OF ANY OUTPUT1 :
  PLACE OUTPUT1 AT 1 :
  CHAN OF ANY OUTPUT2 :
  PLACE OUTPUT2 AT 2 :
  CHAN OF ANY OUTPUT3 :
  PLACE OUTPUT3 AT 3 :
  [4]CHAN OF ANY OUTPUT IS [OUTPUT0, OUTPUT1, OUTPUT2, OUTPUT3] :
  --}}}
  CHAN OF INT16::[]BYTE out IS OUTPUT[boot] :
  BOOL pass :
  [16]BYTE message :
  SEQ
    --{{{  timer
    VAL mess IS "?Timer" :
    SEQ
      [message FROM 0 FOR SIZE mess] := mess
      TimeT222C(pass)
      IF
        pass
          message[0] := ' '
        TRUE
          SKIP
      out ! (INT16 (SIZE mess))::message
    --}}}
    --{{{  Cmux
    VAL mess IS "?Conditional Mux" :
    SEQ
      [message FROM 0 FOR SIZE mess] := mess
      CmuxT222C(pass)
      IF
        pass
          message[0] := ' '
        TRUE
          SKIP
      out ! (INT16 (SIZE mess))::message
    --}}}
    out ! 1(INT16)::"."
    GUY
      OPR $1FF
:


--
--  eof
--
